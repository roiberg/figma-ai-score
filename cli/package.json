{
  "name": "figma-ai-score-cli",
  "version": "0.6.7",
  "description": "CLI for figma-ai-score — talks to the Figma plugin over localhost WebSocket.",
  "type": "module",
  "main": "cli.js",
  "bin": {
    "figma-ai-score": "./cli.js"
  },
  "scripts": {
    "dev:link": "mkdir -p \"$HOME/.local/bin\" && ln -sfn \"$PWD/cli.js\" \"$HOME/.local/bin/figma-ai-score\" && chmod +x cli.js && echo \"Linked $HOME/.local/bin/figma-ai-score → $PWD/cli.js\""
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
